APP_NAME=AgriHub
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=vi
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=agrihub
DB_USERNAME=agrihub
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Sanctum: các host (kèm port) của SPA được phép dùng cookie phiên
SANCTUM_STATEFUL_DOMAINS=localhost:5173,localhost:8000,127.0.0.1:8000

# Audit log: số tháng giữ log và có cho lệnh bảo trì XÓA phân vùng quá hạn hay không (mặc định KHÔNG xóa gì)
AUDIT_RETENTION_MONTHS=24
AUDIT_PURGE_ENABLED=false

# Proxy/Load balancer đáng tin (danh sách IP, phân tách bằng dấu phẩy) để lấy đúng IP client từ X-Forwarded-For. Để trống nếu không có proxy.
TRUSTED_PROXIES=

# Sao lưu/khôi phục: khóa mã hóa file sao lưu (chuỗi ngẫu nhiên >= 32 ký tự; cất TÁCH khỏi nơi lưu file; để trống thì dùng APP_KEY)
BACKUP_ENCRYPTION_KEY=
BACKUP_DISK=backups
BACKUP_MAX_UPLOAD_MB=512
BACKUP_MAX_UNCOMPRESSED_MB=4096

# Sao lưu TOÀN HỆ THỐNG (pg_dump, mọi Tenant): dùng tài khoản database RIÊNG, KHÔNG phải tài khoản của ứng dụng.
# Tài khoản cần: LOGIN, BYPASSRLS, CREATEDB, pg_read_all_data và là thành viên role của ứng dụng (xem docs/BACKUP_DISASTER_RECOVERY.md mục 8).
# Bật lịch tự động (mặc định: bật ở production, tắt ở nơi khác)
# BACKUP_PLATFORM_ENABLED=true
BACKUP_PLATFORM_AT=01:30
BACKUP_PRUNE_AT=03:30
BACKUP_VERIFY_DAY=0
BACKUP_VERIFY_AT=04:30
# Thư mục chứa pg_dump/pg_restore (để trống = tìm trong PATH; phiên bản phải >= phiên bản máy chủ PostgreSQL)
# BACKUP_PG_BIN=
BACKUP_DB_USERNAME=
BACKUP_DB_PASSWORD=
# Mặc định lấy từ DB_HOST / DB_PORT / DB_DATABASE
# BACKUP_DB_HOST=
# BACKUP_DB_PORT=
# BACKUP_DB_DATABASE=
# BACKUP_DB_SSLMODE=

# Sao lưu TỰ ĐỘNG hằng ngày dữ liệu của từng Tenant (mặc định: bật ở production). Cần queue worker + scheduler.
# BACKUP_TENANT_AUTO_ENABLED=true
# BACKUP_TENANT_AT=02:00
# Giữ mọi bản tự động trong số ngày này (luôn giữ ít nhất BACKUP_TENANT_MIN_KEEP bản mới nhất); bản thủ công không bao giờ tự xóa
# BACKUP_TENANT_KEEP_DAYS=30
# BACKUP_TENANT_MIN_KEEP=3

# Mỗi doanh nghiệp một subdomain: <slug>.<tên miền gốc> (vd. nong-phat.agrihub.vn); Super Admin ở admin.<tên miền gốc>.
# Để trống = tắt (một địa chỉ cho tất cả). Phát triển: TENANT_BASE_DOMAIN=localhost và TENANT_URL_PORT=5173, rồi mở http://nong-phat.localhost:5173
# SESSION_DOMAIN phải để trống (null) để cookie chỉ theo từng subdomain.
# TENANT_BASE_DOMAIN=
# TENANT_PLATFORM_LABELS=admin
# TENANT_URL_SCHEME=https
# TENANT_URL_PORT=
# Tên máy chủ nội bộ vẫn được tin dù ngoài tên miền gốc (regex, ngăn cách bằng dấu phẩy; vd. cân bằng tải gọi bằng IP)
# TENANT_EXTRA_TRUSTED_HOSTS=

# Giám sát hạ tầng (xem docs/MONITORING_LOGGING.md). Cảnh báo cho Super Admin: mặc định bật ở production.
# MONITOR_ALERTS_ENABLED=true
# Email nhận cảnh báo hạ tầng NGOÀI các Super Admin (gộp với BACKUP_ALERT_EMAILS)
# MONITOR_ALERT_EMAILS=
# Giám sát từ BÊN NGOÀI (Healthchecks.io, Uptime Kuma push...): mỗi phút gọi URL này khi hệ thống không nghiêm trọng.
# Dịch vụ ngoài báo khi mất tín hiệu — kể cả khi cả máy chủ đã chết.
# MONITOR_PING_URL=
# MONITOR_PING_FAIL_URL=
# Mã cho GET /api/v1/health/monitor (header Authorization: Bearer <mã>); để trống = tắt endpoint. Nên dài và ngẫu nhiên.
# MONITOR_TOKEN=
# Ngưỡng (có mặc định hợp lý): MONITOR_DISK_WARN_PERCENT=80 MONITOR_DISK_CRITICAL_PERCENT=90 MONITOR_HEARTBEAT_WARN_MINUTES=5
# MONITOR_HEARTBEAT_CRITICAL_MINUTES=15 MONITOR_QUEUE_OLDEST_WARN_MINUTES=10 MONITOR_FAILED_JOBS_WARN=1 ... (xem config/monitoring.php)

# Thông báo trạng thái sao lưu (trong ứng dụng + email cho Super Admin; xem docs/BACKUP_DISASTER_RECOVERY.md mục 9).
# Email nhận cảnh báo NGOÀI các Super Admin, ngăn cách bằng dấu phẩy: nên là hộp thư ngoài hệ thống. Cần cấu hình MAIL_* thật ở production.
# BACKUP_ALERT_EMAILS=
# Quá số giờ này chưa có bản sao lưu hoàn tất mới thì báo "quá hạn" (lịch chạy mỗi 24 giờ)
# BACKUP_ALERT_OVERDUE_HOURS=36
# Quá số ngày chưa có lần khôi phục thử nào đạt thì báo (lịch chạy mỗi tuần)
# BACKUP_ALERT_VERIFY_OVERDUE_DAYS=10
# Nhắc tải bản sao lưu về nơi lưu riêng khi quá số ngày chưa tải (0 = không nhắc)
# BACKUP_ALERT_OFFSITE_DAYS=7
# Cùng một cảnh báo chỉ gửi lại sau số giờ này nếu vấn đề vẫn còn
# BACKUP_ALERT_DEDUPE_HOURS=24
