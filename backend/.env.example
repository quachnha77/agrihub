APP_NAME=AgriHub
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=vi
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=agrihub
DB_USERNAME=agrihub
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Sanctum: các host (kèm port) của SPA được phép dùng cookie phiên
SANCTUM_STATEFUL_DOMAINS=localhost:5173,localhost:8000,127.0.0.1:8000

# Audit log: số tháng giữ log và có cho lệnh bảo trì XÓA phân vùng quá hạn hay không (mặc định KHÔNG xóa gì)
AUDIT_RETENTION_MONTHS=24
AUDIT_PURGE_ENABLED=false

# Proxy/Load balancer đáng tin (danh sách IP, phân tách bằng dấu phẩy) để lấy đúng IP client từ X-Forwarded-For. Để trống nếu không có proxy.
TRUSTED_PROXIES=

# Sao lưu/khôi phục: khóa mã hóa file sao lưu (chuỗi ngẫu nhiên >= 32 ký tự; cất TÁCH khỏi nơi lưu file; để trống thì dùng APP_KEY)
BACKUP_ENCRYPTION_KEY=
BACKUP_DISK=backups
BACKUP_MAX_UPLOAD_MB=512
BACKUP_MAX_UNCOMPRESSED_MB=4096

# Sao lưu TOÀN HỆ THỐNG (pg_dump, mọi Tenant): dùng tài khoản database RIÊNG, KHÔNG phải tài khoản của ứng dụng.
# Tài khoản cần: LOGIN, BYPASSRLS, CREATEDB, pg_read_all_data và là thành viên role của ứng dụng (xem docs/BACKUP_DISASTER_RECOVERY.md mục 8).
# Bật lịch tự động (mặc định: bật ở production, tắt ở nơi khác)
# BACKUP_PLATFORM_ENABLED=true
BACKUP_PLATFORM_AT=01:30
BACKUP_PRUNE_AT=03:30
BACKUP_VERIFY_DAY=0
BACKUP_VERIFY_AT=04:30
# Thư mục chứa pg_dump/pg_restore (để trống = tìm trong PATH; phiên bản phải >= phiên bản máy chủ PostgreSQL)
# BACKUP_PG_BIN=
BACKUP_DB_USERNAME=
BACKUP_DB_PASSWORD=
# Mặc định lấy từ DB_HOST / DB_PORT / DB_DATABASE
# BACKUP_DB_HOST=
# BACKUP_DB_PORT=
# BACKUP_DB_DATABASE=
# BACKUP_DB_SSLMODE=
