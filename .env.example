# Biến cho docker-compose (môi trường dev). Sao chép thành .env và đổi giá trị; KHÔNG commit .env.
# Role ứng dụng (không phải superuser; cần để Row-Level Security có hiệu lực)
POSTGRES_DB=agrihub
POSTGRES_USER=agrihub
POSTGRES_PASSWORD=change_me
# Tài khoản quản trị PostgreSQL của container (không dùng cho ứng dụng)
POSTGRES_ADMIN_PASSWORD=change_me_too
